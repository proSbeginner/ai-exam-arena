SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
NEXT_PUBLIC_PLAYER_NAME_MAX_LENGTH=20
NEXT_PUBLIC_PASSING_SCORE_PERCENTAGE=80
