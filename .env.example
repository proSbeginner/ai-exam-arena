# Phase 2a: choose the local mock response used by Next.js Route Handlers.
# Copy this file to .env.local before running the app.
DATA_SOURCE=mock
MOCK_API_SCENARIO=happy
MOCK_API_DELAY_MS=150
NEXT_PUBLIC_PLAYER_NAME_MAX_LENGTH=20
NEXT_PUBLIC_PASSING_SCORE_PERCENTAGE=80
MAX_PLAYER_PIN_ATTEMPTS=20
ADMIN_EMAIL=test@mail.com
